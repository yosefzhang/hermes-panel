# Hermes Panel 配置示例（仅作参考，程序不会自动复制本文件）。
# 程序实际读取当前目录的 config.yaml，缺失时自动生成最小化配置。

# Hermes 数据目录。Docker 下由 compose 挂载宿主机 ~/.hermes 到容器 /root/.hermes。
hermes_path: ~/.hermes

# 服务端口，默认 8090。
port: 8090

# 本面板唯一标识，用于在接收端区分不同来源面板。
# 缺省时首次启动自动生成唯一 ID 并回写；如需自定义可取消注释。
# panel_name: my-panel

# Panel 自身数据目录（JSON 数据 / 日志 / 账号），默认 ./data。
# data_dir: ./data
