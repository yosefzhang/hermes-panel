# Hermes Panel Environment Configuration
#
# Place this file at ~/.config/hermes-panel/.env (loaded automatically on startup).
# Override the path with HERMES_PANEL_ENV if needed.
# Real shell environment variables always take priority over this file.

# Path to Hermes Agent home directory (contains state.db, config.yaml, etc.)
HERMES_HOME=~/.hermes

# SQLite database path for hermes-panel's own data (users, cache)
# Default: ~/.config/hermes-panel/control.db
HERMES_PANEL_DB=~/.config/hermes-panel/control.db

# JWT secret for authentication tokens (CHANGE THIS in production!)
HERMES_PANEL_JWT_SECRET=change-me-in-production

# Default admin password (change this in production!)
HERMES_PANEL_DEFAULT_ADMIN_PASSWORD=admin
