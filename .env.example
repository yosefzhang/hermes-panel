# Hermes Panel Environment Configuration
#
# Place this file at ~/.config/hermes-panel/.env (loaded automatically on startup).
# Override the path with HERMES_PANEL_ENV if needed.
# Real shell environment variables always take priority over this file.

# Path to Hermes Agent home directory (contains state.db, config.yaml, etc.)
HERMES_PATH=~/.hermes

# SQLite database path for hermes-panel's own data.
# All panel tables (users, system metrics, profile statistics and host info)
# live in this single database file.
# Default: ~/.config/hermes-panel/hermes-panel.db
HERMES_PANEL_DB=~/.config/hermes-panel/hermes-panel.db

# JWT secret for authentication tokens (CHANGE THIS in production!)
HERMES_PANEL_JWT_SECRET=changeme

# Default admin password (change this in production!)
HERMES_PANEL_DEFAULT_USER=admin
HERMES_PANEL_DEFAULT_ADMIN_PASSWORD=changeme

# Data sync to another hermes-panel instance.
# When enabled, local profile_stats and host_info tables are periodically
# POSTed to the target panel's /api/v1/sync endpoint.
SYNC_ENABLED=false
# SYNC_TARGET_URL=http://10.0.0.10:8660
# SYNC_TOKEN=replace-with-shared-token

# Allow other hermes-panel instances to push their data to this panel.
# Both sides must set the same shared token for authentication.
SYNC_RECEIVE_ENABLED=false

# Sync interval in seconds.
# SYNC_INTERVAL=60
